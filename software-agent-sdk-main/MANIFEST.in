# This MANIFEST.in file tells setuptools which files to include 
# in the sdist package distribution used for building docker image

# ==============================================================================
# Root-level workspace files
# ==============================================================================
include pyproject.toml
include uv.lock

# ==============================================================================
# madagascar-sdk
# ==============================================================================
include madagascar-sdk/pyproject.toml
recursive-include madagascar-sdk *.py
recursive-include madagascar-sdk *.j2
recursive-include madagascar-sdk py.typed

# ==============================================================================
# madagascar-tools
# ==============================================================================
include madagascar-tools/pyproject.toml
recursive-include madagascar-tools *.py
recursive-include madagascar-tools *.j2
recursive-include madagascar-tools py.typed

# ==============================================================================
# madagascar-workspace
# ==============================================================================
include madagascar-workspace/pyproject.toml
recursive-include madagascar-workspace *.py
recursive-include madagascar-workspace py.typed

# ==============================================================================
# madagascar-agent-server
# ==============================================================================
include madagascar-agent-server/pyproject.toml
recursive-include madagascar-agent-server *.py
recursive-include madagascar-agent-server py.typed

# Docker build files
include madagascar-agent-server/madagascar/agent_server/docker/Dockerfile
include madagascar-agent-server/madagascar/agent_server/docker/wallpaper.svg

# PyInstaller spec
include madagascar-agent-server/madagascar/agent_server/agent-server.spec

# VSCode extensions
recursive-include madagascar-agent-server/madagascar/agent_server/vscode_extensions *
